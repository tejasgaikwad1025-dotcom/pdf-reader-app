</span></span><span><span>        </span><span class="token token key" style="color: rgb(204, 123, 244);">run</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> </span><span class="token token" style="color: rgb(211, 215, 222);">|</span><span class="token token scalar" style="color: rgb(155, 233, 99);">
</span></span><span>          sudo apt-get update
</span><span>          sudo apt-get install -y git zip unzip build-essential libssl-dev libffi-dev cmake autoconf automake libtool pkg-config
</span><span><span class="token token scalar" style="color: rgb(155, 233, 99);">          pip install buildozer==1.5.0 cython==0.29.37</span><span>
</span></span><span>
