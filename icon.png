</span></span><span><span>      </span><span class="token token" style="color: rgb(211, 215, 222);">-</span><span> </span><span class="token token key" style="color: rgb(204, 123, 244);">name</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> Upload APK
</span></span><span><span>        </span><span class="token token key" style="color: rgb(204, 123, 244);">uses</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span> actions/upload</span><span class="token token" style="color: rgb(211, 215, 222);">-</span><span>artifact@v3
</span></span><span><span>        </span><span class="token token key" style="color: rgb(204, 123, 244);">with</span><span class="token token" style="color: rgb(211, 215, 222);">:</span><span>
